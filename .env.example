# Supabase
NEXT_PUBLIC_SUPABASE_URL=sua-url-aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui (opcional, apenas server-side)

# Conta de demonstração (apenas server-side — nunca use o prefixo NEXT_PUBLIC_)
# A rota POST /api/demo-login lê estas variáveis. Sem DEMO_PASSWORD ela responde 503.
DEMO_EMAIL=demo@manutflow.com
DEMO_PASSWORD=sua-senha-demo-aqui
